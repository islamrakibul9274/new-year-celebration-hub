# ============================================================
# New Year Celebration Hub — Environment Variables
# Copy to .env.local and fill in. For Netlify deploys these are
# configured in Site settings → Environment variables.
# ============================================================

# --- Auth (required) ---
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Canonical site URL (used for password-reset links & Stripe redirects)
AUTH_URL="http://localhost:3000"

# --- Database (required) ---
# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=""

# --- Stripe (optional — demo activation works without it) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Groq AI (required for AI resolutions & greeting cards) ---
GROQ_API_KEY=""

# --- Resend email (optional — skipped when unset) ---
RESEND_API_KEY=""

# --- Pusher (required for the live lounge) ---
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# --- Cloudinary (required for avatar uploads) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
